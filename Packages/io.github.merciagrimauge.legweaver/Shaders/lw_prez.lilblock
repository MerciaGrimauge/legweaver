        // LegWeaver: 先に深度を描き、透けるニットの最も手前の層だけを描くようにする。衣装が自身と重なるところ
        // （下から見た太ももの間）では、そうしないと透明な三角形が描かれる順のままに混ざり、
        // 暗くぎざぎざした斑に見える。
        Pass
        {
            Name "LW_PREZ"
            Tags {"LightMode" = "Always"}
            ColorMask 0
            ZWrite On
            Cull [_Cull]
            CGPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #include "UnityCG.cginc"
            float4 vert(float4 v : POSITION) : SV_POSITION { return UnityObjectToClipPos(v); }
            fixed4 frag() : SV_Target { return 0; }
            ENDCG
        }
